# Orchestration only — app runtime config lives in each app's own .env.
POSTGRES_PORT=5432   # host port for the docker-compose Postgres

# Workspace id (portless URLs + OTel name) and the Docker project both default
# to this directory's name — no config needed per worktree / jj workspace / clone.
# Override the id for one run by exporting it: DEV_INSTANCE=api bun run dev
