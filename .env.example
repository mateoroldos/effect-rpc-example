# Copy this file to .env in each workspace. Keep both values unique while
# another workspace is running.
DEV_INSTANCE=main
POSTGRES_PORT=5432

APP_ENV=development
DATABASE_URL=postgresql://effect_template:effect_template@127.0.0.1:5432/effect_template
API_URL=https://main.api.effect-template.localhost

# Optional telemetry
# LOG_LEVEL=Debug
# OTEL_SERVICE_VERSION=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS_JSON={"authorization":"Bearer <token>"}
