{
  "name": "effect-template",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch",
    "env:setup": "sh scripts/setup-env.sh",
    "dev": "sh scripts/with-instance.sh bunx turbo dev",
    "dev:full": "bun run telemetry:up && sh scripts/with-instance.sh bunx turbo dev",
    "db:setup": "bun run db:up && bun run db:migrate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down --remove-orphans",
    "db:destroy": "sh scripts/with-instance.sh sh scripts/drop-db.sh",
    "db:nuke": "docker compose down --volumes --remove-orphans",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "sh scripts/with-instance.sh sh scripts/db-migrate.sh",
    "telemetry:up": "./scripts/start-maple.sh",
    "infra:deploy": "alchemy deploy --yes",
    "infra:deploy:prod": "alchemy deploy --yes --stage prod",
    "infra:destroy": "alchemy destroy --yes",
    "check-types": "turbo check-types && tsc -p tsconfig.alchemy.json",
    "test": "vitest run",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "alchemy": "2.0.0-beta.65",
    "effect": "catalog:",
    "@effect/language-service": "^0.87.1",
    "@effect/tsgo": "^0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "catalog:",
    "knip": "^6.29.0",
    "portless": "^0.15.5",
    "turbo": "^2.8.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18",
    "ultracite": "^7.8.1"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "nanoid": "3.3.17"
  },
  "catalog": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0-beta.102"
  }
}
