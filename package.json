{
  "name": "effect-template",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch",
    "dev": "bun run db:up && turbo dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "check-types": "turbo check-types",
    "test": "vitest run",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@effect/language-service": "^0.87.1",
    "@effect/tsgo": "^0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "catalog:",
    "knip": "^6.29.0",
    "turbo": "^2.8.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18",
    "ultracite": "^7.8.1"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0-beta.102"
  }
}
