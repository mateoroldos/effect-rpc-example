# Deploy-time credentials for `bun run infra:deploy` (Alchemy).
#
# These authenticate Alchemy to each provider while it PROVISIONS resources.
# They are NOT runtime secrets — the Railway apps never see them. Keep the real
# values in GitHub Actions environment secrets (CI) and a local gitignored copy
# (`cp alchemy.env.example .env.deploy`, then `set -a; source .env.deploy`).

# Cloudflare — R2 bucket, email API token, DNS, and Alchemy state (DO SQLite).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon — serverless Postgres project + branch.
NEON_API_KEY=

# Axiom — telemetry dataset + ingest token.
AXIOM_TOKEN=
# AXIOM_ORG_ID=   # only if your token is org-scoped

# Prod custom domains (optional). When set, resolveDomains derives
# api.<domain> / app.<domain> for the deploy summary. DNS records are created
# manually (see the deploy runbook) since Railway's CNAME target is only known
# after the Railway service exists.
# APP_DOMAIN=example.com

# Throwaway local state (.alchemy/) instead of the shared Cloudflare state store.
# ALCHEMY_LOCAL_STATE=1
