# Deploy-time creds for `bun run infra:deploy` (Alchemy) — authenticate provisioning
# only; Copy to .env.deploy (gitignored) or set in CI secrets.

# Cloudflare — R2, DNS, email token, Alchemy state.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon — serverless Postgres.
NEON_API_KEY=

# Axiom — telemetry ingest.
AXIOM_TOKEN=
# AXIOM_ORG_ID=          # only if the token is org-scoped

# Prod domains (optional) — derives api.<domain>/app.<domain>; DNS added manually.
# APP_DOMAIN=example.com

# Use throwaway local state (.alchemy/) instead of the shared Cloudflare store.
# ALCHEMY_LOCAL_STATE=1
