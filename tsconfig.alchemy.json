{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@effect-template/infra": ["./packages/infra/src/index.ts"],
      "@effect-template/infra/config": ["./packages/infra/src/config.ts"]
    }
  },
  "include": ["alchemy.run.ts"]
}
