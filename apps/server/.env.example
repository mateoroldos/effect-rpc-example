# apps/server runtime — loaded by Bun from this dir. Prod values live in Railway.

APP_ENV=development
# DATABASE_URL: derived locally as eff_<workspace-id> in the shared Postgres; required in prod/Neon.

# Telemetry export — unset → console only. Service name is derived in code.
#   local: `bun run telemetry:up`, then uncomment the localhost line
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   prod (Axiom): the endpoint + headers below
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
# OTEL_EXPORTER_OTLP_HEADERS_JSON={"authorization":"Bearer <token>","x-axiom-dataset":"<dataset>"}
# OTEL_SERVICE_VERSION=1.0.0
# LOG_LEVEL=Debug

# Email — unset locally logs instead of sending; token from `infra:deploy`.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=effect-template

# Object storage (R2) — wired when used.
# R2_ACCOUNT_ID=
# R2_BUCKET=effect-template
