APP_ENV=development

DATABASE_URL=postgresql://effect_template:effect_template@localhost:5432/effect_template

OTEL_SERVICE_NAME=effect-template-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Exporter headers as a JSON object (e.g. auth for a hosted OTLP backend):
# OTEL_EXPORTER_OTLP_HEADERS_JSON={"authorization":"Basic dXNlcjpwYXNz"}

# --- Transactional email (Cloudflare Email Sending over REST) ---
# Absent locally → the server logs messages instead of sending (layerLog).
# In prod set all three; the API token is provisioned by `bun run infra:deploy`.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=effect-template

# --- Object storage (Cloudflare R2) ---
# Provisioned empty for now; scoped S3 keys get wired when R2 is actually used.
# R2_ACCOUNT_ID=
# R2_BUCKET=effect-template
