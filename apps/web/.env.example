# apps/web runtime — loaded by Vite/SvelteKit, validated by src/env.ts.

APP_ENV=development
# The development command derives APP_DOMAIN from DEV_INSTANCE. Set it explicitly in production.
# LOG_LEVEL=Debug               # override; defaults Debug (dev) / Info (prod)

# Telemetry export — unset → console only. Service name is derived in code.
#   local: `bun run telemetry:up`, then uncomment the localhost line
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   prod (Axiom): the endpoint + headers below
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
# OTEL_EXPORTER_OTLP_HEADERS_JSON={"authorization":"Bearer <token>","x-axiom-dataset":"<dataset>"}
# OTEL_SERVICE_VERSION=1.0.0
