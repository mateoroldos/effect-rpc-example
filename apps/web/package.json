{
  "name": "@effect-template/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "check-types": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "dev": "portless run --name \"app.${DEV_INSTANCE:?run 'bun run dev' from the repo root}.effect-template\"",
    "dev:app": "vite dev --host ${HOST:-127.0.0.1} --port ${PORT:-5173} --strictPort",
    "lint": "biome check src",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@effect-template/domain": "workspace:*",
    "@effect-template/observability": "workspace:*",
    "@effect-template/rpc": "workspace:*",
    "@effect/platform-node": "catalog:",
    "better-auth": "1.7.0-rc.5",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-node": "next",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "phosphor-svelte": "^3.1.0",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "vite": "^8.0.16"
  },
  "portless": {
    "name": "effect-template",
    "script": "dev:app"
  }
}
